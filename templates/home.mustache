{{!
    @template theme_iqralight/home

    Top of the learner's home page: greeting, data avoided this month, and the "Resume" card.

    Example context (json):
    {
        "greeting": "Hello, Amina",
        "date": "Tuesday 28 October",
        "hascourses": true,
        "allcoursesurl": "#",
        "courses": [{"name": "Road safety, level 1", "url": "#", "category": "Driving", "tone": "brand", "hasprogress": true, "percent": 60}],
        "saved": "Iqralight spared you 35 MB of data this month.",
        "resume": {
            "coursename": "French, level 1",
            "sectionname": "Chapter 2",
            "activityname": "Introducing yourself",
            "url": "#",
            "hasprogress": true,
            "done": 6,
            "total": 10,
            "percent": 60,
            "ctalabel": "Continue",
            "kicker": "Pick up where you left off"
        }
    }
}}
<div class="iqra-home-top">
    <div class="iqra-greeting">
        <h1 class="iqra-greeting-title">{{greeting}}</h1>
        <p class="iqra-greeting-date">{{date}}</p>
    </div>
    {{#saved}}
    <p class="iqra-saved">{{saved}}</p>
    {{/saved}}
</div>
{{#resume}}
    {{> theme_iqralight/resume }}
{{/resume}}
{{#hascourses}}
<section class="iqra-mycourses" aria-labelledby="iqra-mycourses-title">
    <div class="iqra-section-head">
        <h2 id="iqra-mycourses-title" class="iqra-section-title">{{#str}}mycourses, theme_iqralight{{/str}}</h2>
        <a class="iqra-section-link" href="{{allcoursesurl}}">{{#str}}allmycourses, theme_iqralight{{/str}}</a>
    </div>
    <ul class="iqra-coursegrid">
        {{#courses}}
        <li>
            <a class="iqra-coursecard" href="{{url}}">
                <span class="iqra-coursecard-cover iqra-tone-{{tone}}"><span class="iqra-coursecard-category">{{category}}</span></span>
                <span class="iqra-coursecard-body">
                    <span class="iqra-coursecard-name">{{name}}</span>
                    {{#hasprogress}}
                    <span class="iqra-coursecard-progress">
                        <span class="iqra-meter" aria-hidden="true"><span class="iqra-meter-bar" style="width: {{percent}}%"></span></span>
                        <span class="iqra-coursecard-percent">{{#str}}percentdone, theme_iqralight, {{percent}}{{/str}}</span>
                    </span>
                    {{/hasprogress}}
                </span>
            </a>
        </li>
        {{/courses}}
    </ul>
</section>
{{/hascourses}}
