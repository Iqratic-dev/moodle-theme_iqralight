{{!
    @template theme_iqralight/activitynav

    Large "Next" button at the bottom of an activity, with "Previous" as a secondary link.
    On the last activity, the main button goes back to the course.

    Example context (json):
    {
        "next": {"url": "#", "label": "Next: Take the quiz"},
        "previous": {"url": "#", "label": "Previous"},
        "courseurl": "#"
    }
}}
<nav class="iqra-activitynav d-print-none" aria-label="{{#str}}activitynav, theme_iqralight{{/str}}">
    {{#next}}
    <a class="iqra-activitynav-next" href="{{url}}">
        <span>{{label}}</span>
        <svg class="iqra-flip-rtl" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
    </a>
    {{/next}}
    {{^next}}
    <a class="iqra-activitynav-next" href="{{courseurl}}">
        <span>{{#str}}backtocourse, theme_iqralight{{/str}}</span>
    </a>
    {{/next}}
    {{#previous}}
    <a class="iqra-activitynav-previous" href="{{url}}">{{label}}</a>
    {{/previous}}
</nav>
