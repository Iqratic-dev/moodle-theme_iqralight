{{!
    @template theme_iqralight/resume

    The "Resume" card: the course used last, where to continue, and progress.

    Example context (json):
    {
        "coursename": "French, level 1",
        "sectionname": "Chapter 2",
        "activityname": "Introducing yourself",
        "url": "#",
        "hasprogress": true,
        "done": 6,
        "total": 10,
        "percent": 60,
        "ctalabel": "Continue",
        "kicker": "Pick up where you left off"
    }
}}
<section class="iqra-resume" aria-labelledby="iqra-resume-title">
    <p class="iqra-resume-kicker">{{kicker}}</p>
    <h2 id="iqra-resume-title" class="iqra-resume-course">{{coursename}}</h2>
    {{#activityname}}
    <p class="iqra-resume-where"><span>{{sectionname}}</span> <span class="iqra-resume-activity">{{activityname}}</span></p>
    {{/activityname}}
    {{#hasprogress}}
    <div class="iqra-progress" role="progressbar" aria-valuenow="{{percent}}" aria-valuemin="0" aria-valuemax="100" aria-label="{{#str}}progresslabel, theme_iqralight{{/str}}">
        <div class="iqra-progress-bar" style="width: {{percent}}%"></div>
    </div>
    <p class="iqra-resume-progress">{{#str}}progress, theme_iqralight, { "done": {{done}}, "total": {{total}} }{{/str}}</p>
    {{/hasprogress}}
    <a class="iqra-resume-cta" href="{{url}}">
        <span>{{ctalabel}}</span>
        <svg class="iqra-flip-rtl" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
    </a>
</section>
